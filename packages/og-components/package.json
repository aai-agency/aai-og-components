{
  "name": "@aai-agency/og-components",
  "version": "0.5.1",
  "description": "Production-grade O&G React components for AI coding agents — maps, charts, detail cards, and more",
  "author": "Husam @ aai.agency <husam@aai.agency>",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./asset-card": {
      "types": "./dist/components/asset-card/index.d.ts",
      "import": "./dist/components/asset-card/index.js"
    },
    "./decline-curve": {
      "types": "./dist/components/decline-curve/index.d.ts",
      "import": "./dist/components/decline-curve/index.js"
    },
    "./line-chart": {
      "types": "./dist/components/line-chart/index.d.ts",
      "import": "./dist/components/line-chart/index.js"
    },
    "./map": {
      "types": "./dist/components/map/index.d.ts",
      "import": "./dist/components/map/index.js"
    },
    "./ui": {
      "types": "./dist/components/ui/index.d.ts",
      "import": "./dist/components/ui/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "import": "./dist/services/index.js"
    },
    "./machines": {
      "types": "./dist/machines/index.d.ts",
      "import": "./dist/machines/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./sample-data": {
      "types": "./dist/sample-data/index.d.ts",
      "import": "./dist/sample-data/index.js"
    }
  },
  "files": [
    "dist",
    "src/styles.css",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "mapbox-gl": ">=3",
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=4"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.10",
    "@deck.gl/layers": "^9.3.10",
    "@deck.gl/mapbox": "^9.3.10",
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@turf/turf": "^7.4.0",
    "@xstate/react": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "deck.gl": "^9.3.10",
    "jszip": "^3.10.1",
    "lucide-react": "^1.32.0",
    "react-virtuoso": "^4.18.12",
    "shpjs": "^6.2.0",
    "sql.js": "^1.14.2",
    "supercluster": "^9.0.0",
    "tailwind-merge": "^3.6.0",
    "uplot": "^1.6.32",
    "xstate": "^5.32.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/shpjs": "^3.4.7",
    "@types/supercluster": "^7.1.3",
    "mapbox-gl": "^3.28.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "keywords": [
    "oil-gas",
    "asset-map",
    "well-map",
    "petroleum",
    "upstream",
    "pipeline",
    "xstate",
    "production-data",
    "react-components",
    "shadcn",
    "kmz",
    "kml",
    "geojson"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aai-agency/aai-og-components"
  },
  "homepage": "https://github.com/aai-agency/aai-og-components",
  "bugs": "https://github.com/aai-agency/aai-og-components/issues"
}
